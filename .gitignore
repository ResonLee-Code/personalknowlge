# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/
dist-windows/
*.local

# rust
src-tauri/target/
target/

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs
*.log
npm-debug.log*
pnpm-debug.log*

